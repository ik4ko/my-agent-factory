{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Agent Factory",
  "version": "0.1.0",
  "identifier": "com.myagentfactory.controlroom",
  "build": {
    "devUrl": "http://localhost:9002",
    "frontendDist": "http://localhost:9002",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "echo skip"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "My Agent Factory — Control Room",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
