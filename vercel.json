{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/scheduler/aep",           "schedule": "0 9 * * *"  },
    { "path": "/api/scheduler/vcc",           "schedule": "0 8 * * *"  },
    { "path": "/api/scheduler/notifications", "schedule": "0 10 * * *" },
    { "path": "/api/scheduler/detection",     "schedule": "0 6 * * *"  },
    { "path": "/api/cron/process-alerts",     "schedule": "0 0 * * *"  }
  ]
}