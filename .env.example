# Core dashboard auth
DASHBOARD_PASSWORD=
MACHINE_API_TOKEN=
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Active paid brains only
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Live-data tools (see src/lib/tools/live-tools.ts). web_search needs a
# Tavily key (free tier ~1k requests/mo at tavily.com); weather (Open-Meteo)
# and stock quotes (Yahoo Finance public data) need NO key. Without the
# Tavily key, search degrades to a "not configured" message — nothing breaks.
TAVILY_API_KEY=

# Local AI backend (optional — see docs/local-ai-backend.md).
# Setting AI_LOCAL_BASE_URL reroutes every OpenRouter-lane call to a local
# OpenAI-compatible server (LM Studio :1234, Ollama :11434) and skips the
# OpenRouter budget gate. AI_LOCAL_MODEL forces the served model name;
# AI_LOCAL_API_KEY is only needed if your local server enforces auth.
# OPENROUTER_BASE_URL overrides the hosted default (rarely needed).
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
OPENROUTER_BASE_URL=

# Budget guards (USD/month)
CONVERSE_MONTHLY_BUDGET_USD=3
AGENT_REGISTRY_MONTHLY_BUDGET_USD=3
ANTHROPIC_MONTHLY_BUDGET_USD=3
OPENROUTER_MONTHLY_BUDGET_USD=1

# Safety defaults: leave unset/false unless intentionally testing fallback or mirror behavior.
AGENT_REGISTRY_ALLOW_ANTHROPIC_FALLBACK=false
OMNIGENT_ENABLED=false
OMNIGENT_MIRROR_ENABLED=false
OMNIGENT_WRAPPER_URL=http://127.0.0.1:7900
OMNIGENT_WRAPPER_TOKEN=
OMNIGENT_SERVER_URL=http://127.0.0.1:6767

# Optional email integration
GMAIL_USER=
GMAIL_APP_PASSWORD=
COMMS_REQUIRE_APPROVAL=true

# Trading/market dry-run controls
KILL_SWITCH=false
OPERATOR_PIN=
SYMBOL_ALLOWLIST=
FINNHUB_API_KEY=
OPTIONS_FLOW_PROVIDER=disabled
OPTIONS_FLOW_SYMBOLS=SPY,QQQ,NVDA
OPTIONS_FLOW_MIN_CONTRACTS=1000
OPTIONS_FLOW_MIN_PREMIUM_USD=1000000
OPTIONS_FLOW_MAX_AGE_MINUTES=30
OPTIONS_FLOW_MAX_ALERTS_PER_SCAN=25
OPTIONS_FLOW_NOTIFY=true
OPTIONS_FLOW_POLL_MS=60000
INTRINIO_API_KEY=
PAPER_EQUITY_USD=10000
MAX_TRADE_USD=250
MAX_OPEN_POSITIONS=5
MAX_ORDERS_PER_HOUR=20
DAILY_LOSS_LIMIT_USD=500
QUOTE_MOVE_THRESHOLD_PCT=1.5

# Local workers / realtime
NEXT_PUBLIC_AGENT_SOCKET_URL=ws://127.0.0.1:8765
LOOP_TICK_MS=5000
NEWS_POLL_MS=45000
QUOTE_POLL_MS=30000
SANDBOX_ROOT=
VOYAGE_API_KEY=

# Medicare room — Bridge Health
# Read by src/app/api/website-leads/health/route.ts, server-to-server. These
# exact names are what the code checks; the panel reports "not configured"
# (never a misleading healthy state) if either is unset.
# WEBSITE_LEAD_HEALTH_TOKEN must equal the website's LEAD_HEALTH_TOKEN.
WEBSITE_LEAD_HEALTH_URL=
WEBSITE_LEAD_HEALTH_TOKEN=
